{
  "name": "crossfolk",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-07",
  "assets": { "directory": "./public" },
  "observability": { "enabled": true },
  // OPENROUTER_SITE_URL is optional attribution; set it here or in the dashboard if wanted.
  "vars": { "OPENROUTER_MODELS": "" },
  "ratelimits": [
    { "name": "WORDS_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ]
}
