{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "crossfolk",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-07",
  "assets": {
    "directory": "./public"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      // switch to 0.01 for high traffic sites
      "head_sampling_rate": 0.1
    }
  },
  // Set OPENROUTER_SITE_URL in the dashboard to the app's primary public URL for OpenRouter attribution.
  "vars": {
    "OPENROUTER_MODELS": ""
  },
  "d1_databases": [
    {
      "binding": "APP_DB",
      "database_name": "crossfolk-db",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "WORDS_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ]
}
