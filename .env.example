# Copy this file to .env for npm start. Keep real API keys in .env only.

# Local HTTP server and SQLite database.
PORT=3000
APP_DB_PATH=.local/crossfolk.sqlite

# Required for custom themes; curated themes work without a key.
# AI generation also needs an enabled database policy (see DEPLOYMENT.md).
OPENROUTER_API_KEY=

# Comma-separated model preference order. Empty uses the built-in defaults.
OPENROUTER_MODELS=
# Legacy single-model alias, used only when OPENROUTER_MODELS is empty.
OPENROUTER_MODEL=

# Public URL used as OpenRouter's HTTP-Referer app attribution header.
OPENROUTER_SITE_URL=

# Optional cache for scripts/build-american-patterns.mjs only. Export this in
# your shell when running the script; npm start is the only command that loads .env.
# AMERICAN_MASK_CACHE=.local/american-mask-cache.json
