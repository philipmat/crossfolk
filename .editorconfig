root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
max_line_length = 120
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

[*.{js,mjs}]
indent_size = 2

[*.json]
indent_size = 2

[*.css]
indent_size = 4

[*.html]
indent_size = 4
